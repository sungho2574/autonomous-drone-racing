Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 20
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Gates
      Enabled: true
      Topic:
        Value: /adr/gate_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: PlannedPath
      Enabled: true
      Color: 25; 255; 0
      Line Style: Lines
      Topic:
        Value: /adr/planned_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: FlownPath
      Enabled: true
      Color: 255; 25; 0
      Line Style: Lines
      Topic:
        Value: /adr/flown_path
      Value: true
    # 게이트 PnP 로 추정한 위치 (계측용, 제어 미반영). 인식된 순간마다 그 자리에 파란 X.
    # 색은 마커 자체에 들어 있다. 빨간 FlownPath 와 겹쳐 보면 편차가 바로 드러난다.
    - Class: rviz_default_plugins/Marker
      Name: PnPMarks
      Enabled: true
      Topic:
        Value: /adr/pnp/marks
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odom
      Enabled: true
      Keep: 1
      Shape:
        Shaft Length: 0.5
        Value: Arrow
      Topic:
        Value: /adr/odom
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /adr/camera/image_raw
        Reliability Policy: Best Effort
      Value: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Pitch: 0.6
      Yaw: 0.8
      Name: Current View
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
