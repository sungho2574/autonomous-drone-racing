    <!-- 텍스처 바닥 (adr_ground): 윗면이 z=0 -->
    <include>
      <uri>model://adr_ground</uri>
      <name>adr_ground</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ===== 게이트 4개 (gates.yaml) — 원점 = 개구부 중심, yaw = 통과 방향 ===== -->
    <include>
      <uri>model://adr_gate</uri>
      <name>gate_1</name>
      <pose>4.0 0.0 1.5 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://adr_gate</uri>
      <name>gate_2</name>
      <pose>0.0 4.0 1.5 0 0 3.141593</pose>
    </include>
    <include>
      <uri>model://adr_gate</uri>
      <name>gate_3</name>
      <pose>-4.0 0.0 1.5 0 0 4.712389</pose>
    </include>
    <include>
      <uri>model://adr_gate</uri>
      <name>gate_4</name>
      <pose>0.0 -4.0 1.5 0 0 0.000000</pose>
    </include>

    <!-- ===== 드론 (start 지점 바닥, PX4 는 PX4_GZ_MODEL_NAME=adr_racer 로 붙는다) ===== -->
    <include>
      <uri>model://adr_racer</uri>
      <name>adr_racer</name>
      <pose>2.83 -2.83 0.05 0 0 0</pose>
    </include>
