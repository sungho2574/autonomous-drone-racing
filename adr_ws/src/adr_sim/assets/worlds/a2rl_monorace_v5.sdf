<?xml version="1.0" encoding="UTF-8"?>
<!-- 자동 생성: adr_sim/scripts/gen_world.py (입력: adr_bringup/config/maps/a2rl_monorace_v5.yaml). 직접 수정하지 말 것. -->
<sdf version="1.9">
  <world name="a2rl_monorace_v5">
    <!-- PX4 standalone 모드용 시스템 플러그인 (PX4 gz_bridge/server.config 와 동일 구성) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>488</elevation>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>

    <!-- 먼 배경용 무한 평면. 텍스처 바닥(adr_ground)이 그 위 z=0 에 깔린다 -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.55 0.6 0.55 1</ambient>
            <diffuse>0.55 0.6 0.55 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 게이트 (a2rl_monorace_v5.yaml). 원점 = 개구부 중심, yaw = 통과 방향. 가상 게이트는 놓지 않는다 ===== -->
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_1</name>
      <pose>-25 14 1.4 0 0 2.181662</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_2</name>
      <pose>-19 30 1.4 0 0 1.308997</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_3</name>
      <pose>-22 46 1.4 0 0 1.745329</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_4</name>
      <pose>-20 63 4.1 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_5</name>
      <pose>-18 85 4.1 0 0 1.570796</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_6</name>
      <pose>-18 85 1.4 0 0 4.712389</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_7</name>
      <pose>-13 68 1.4 0 0 4.974188</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_8</name>
      <pose>-7 55 1.4 0 0 4.712389</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_9</name>
      <pose>-12 37 1.4 0 0 4.712389</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_10</name>
      <pose>-7 19 1.4 0 0 4.712389</pose>
    </include>
    <include>
      <uri>model://adr_gate_a2rl_monorace_v5</uri>
      <name>gate_11</name>
      <pose>-14 9 1.4 0 0 3.141593</pose>
    </include>

    <!-- ===== 드론 (start 지점 바닥, PX4 는 PX4_GZ_MODEL_NAME=adr_racer 로 붙는다) ===== -->
    <include>
      <uri>model://adr_racer</uri>
      <name>adr_racer</name>
      <pose>-22.0 8.0 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>
