<?xml version="1.0"?>
<!-- 자동 생성: racing_env/make_track_pack.py (입력: 맵 a2rl_monorace.yaml 의 panels:).
     판형 게이트 — 폭 2.7 m, z 0~6.35 m, 두께 0.05 m, 구멍 z=1.4 (1.5 m 정사각), z=5 (1.5 m 정사각).
     원점 = 판 중심선의 맵 z=0 지점, +x = 통과 방향(법선). static. -->
<sdf version="1.9">
  <model name="adr_panel_t4_a2rl_monorace">
    <static>true</static>
    <link name="side_left">
      <pose>0 1.05 3.175 0 0 0</pose>
      <visual name="side_left_visual">
        <geometry><box><size>0.05 0.6 6.35</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="side_left_collision">
        <geometry><box><size>0.05 0.6 6.35</size></box></geometry>
      </collision>
    </link>
    <link name="side_right">
      <pose>0 -1.05 3.175 0 0 0</pose>
      <visual name="side_right_visual">
        <geometry><box><size>0.05 0.6 6.35</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="side_right_collision">
        <geometry><box><size>0.05 0.6 6.35</size></box></geometry>
      </collision>
    </link>
    <link name="mid_0">
      <pose>0 0 0.325 0 0 0</pose>
      <visual name="mid_0_visual">
        <geometry><box><size>0.05 1.5 0.65</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="mid_0_collision">
        <geometry><box><size>0.05 1.5 0.65</size></box></geometry>
      </collision>
    </link>
    <link name="mid_1">
      <pose>0 0 3.2 0 0 0</pose>
      <visual name="mid_1_visual">
        <geometry><box><size>0.05 1.5 2.1</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="mid_1_collision">
        <geometry><box><size>0.05 1.5 2.1</size></box></geometry>
      </collision>
    </link>
    <link name="mid_2">
      <pose>0 0 6.05 0 0 0</pose>
      <visual name="mid_2_visual">
        <geometry><box><size>0.05 1.5 0.6</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="mid_2_collision">
        <geometry><box><size>0.05 1.5 0.6</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
