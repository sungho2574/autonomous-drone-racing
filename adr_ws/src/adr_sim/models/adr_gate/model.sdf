<?xml version="1.0"?>
<!-- 정사각 레이싱 게이트. 내부 1.5 m, 외부 2.1 m (프레임 폭 0.30 m), 두께 0.1 m.
     원점 = 개구부 중심, +x = 통과 방향(법선). static 이라 공중에 고정된다(다리 없음).
     치수는 adr_bringup/config/gates.yaml 의 gate: 항목과 일치해야 한다. -->
<sdf version="1.9">
  <model name="adr_gate">
    <static>true</static>
    <link name="left">
      <pose>0 0.9 0 0 0 0</pose>
      <visual name="left_visual">
        <geometry><box><size>0.1 0.30000000000000004 2.1</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="left_collision">
        <geometry><box><size>0.1 0.30000000000000004 2.1</size></box></geometry>
      </collision>
    </link>
    <link name="right">
      <pose>0 -0.9 0 0 0 0</pose>
      <visual name="right_visual">
        <geometry><box><size>0.1 0.30000000000000004 2.1</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="right_collision">
        <geometry><box><size>0.1 0.30000000000000004 2.1</size></box></geometry>
      </collision>
    </link>
    <link name="top">
      <pose>0 0 0.9 0 0 0</pose>
      <visual name="top_visual">
        <geometry><box><size>0.1 1.5 0.30000000000000004</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="top_collision">
        <geometry><box><size>0.1 1.5 0.30000000000000004</size></box></geometry>
      </collision>
    </link>
    <link name="bottom">
      <pose>0 0 -0.9 0 0 0</pose>
      <visual name="bottom_visual">
        <geometry><box><size>0.1 1.5 0.30000000000000004</size></box></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="bottom_collision">
        <geometry><box><size>0.1 1.5 0.30000000000000004</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
