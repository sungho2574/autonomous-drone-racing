+void ROS2Visualizer::publish_tracking_metrics(double timestamp) {
+  if (pub_tracking_metrics->get_subscription_count() == 0)
+    return;
+  const auto ids_by_camera = _app->get_tracker_ids();
+  std::unordered_set<size_t> unique_ids;
+  size_t observations = 0;
+  for (const auto &camera : ids_by_camera) {
+    observations += camera.second.size();
+    unique_ids.insert(camera.second.begin(), camera.second.end());
+  }
+  diagnostic_msgs::msg::DiagnosticArray msg;
+  msg.header.stamp = ROSVisualizerHelper::get_time_from_seconds(timestamp);
+  diagnostic_msgs::msg::DiagnosticStatus status;
+  status.name = "openvins/tracker";
+  status.hardware_id = "openvins";
+  status.level = diagnostic_msgs::msg::DiagnosticStatus::OK;
+  status.message = "Current tracker IDs, including newly detected points; stereo IDs counted once";
+  const bool is_klt = _app->get_params().use_klt;
+  auto add = [&status](const std::string &key, size_t value) {
+    diagnostic_msgs::msg::KeyValue item;
+    item.key = key;
+    item.value = std::to_string(value);
+    status.values.push_back(item);
+  };
+  add("tracker_is_klt", is_klt ? 1 : 0);
+  add("tracker_active_features", unique_ids.size());
+  if (is_klt) {
+    add("klt_features", unique_ids.size());
+    add("klt_observations", observations);
+  }
+  msg.status.push_back(status);
+  pub_tracking_metrics->publish(msg);
+}
